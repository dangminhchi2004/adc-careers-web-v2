PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_USER=root
DB_PASSWORD=123456
DB_NAME=adc_careers

JWT_SECRET=replace_with_a_strong_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# Use local storage by default for development.
# Supported values: local, onedrive, sharepoint, google_drive.
CV_STORAGE=local

# Required when CV_STORAGE=onedrive.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_USER_ID=
ONEDRIVE_BASE_PATH=ADC-Careers/CVs

# Required when CV_STORAGE=sharepoint.
# Reuses MS_TENANT_ID, MS_CLIENT_ID, and MS_CLIENT_SECRET above.
SHAREPOINT_DRIVE_ID=
SHAREPOINT_BASE_PATH=ADC-Careers/CVs

# Required when CV_STORAGE=google_drive.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
