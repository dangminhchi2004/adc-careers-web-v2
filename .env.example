PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
# Path to the DB provider's CA certificate (e.g. certs/ca.pem for Aiven). Required
# to set DB_SSL_REJECT_UNAUTHORIZED=true safely — without it TLS is negotiated but
# the server certificate isn't verified, so the connection has no MITM protection.
DB_SSL_CA=
DB_USER=root
DB_PASSWORD=123456
DB_NAME=adc_careers

JWT_SECRET=replace_with_a_strong_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# Use local storage by default for development.
# Supported values: local, onedrive, sharepoint, google_drive, mail_relay.
CV_STORAGE=local

# mail_relay: CV is not uploaded by the backend at all. It is emailed as an attachment
# to MAIL_HR_TO (see mail settings below), and a Power Automate flow watching that
# mailbox saves the attachment into SharePoint using its exact file name. The DB only
# stores the file name; the admin panel links to CV_VIEW_BASE_URL + file name.
# Requires MAIL_ENABLED=true and MAIL_HR_TO to be set, or CV submission will fail.
# Switch CV_STORAGE back to "sharepoint" at any time to resume direct backend upload.
CV_VIEW_BASE_URL=

# Required when CV_STORAGE=onedrive.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_USER_ID=
ONEDRIVE_BASE_PATH=ADC-Careers/CVs

# Required when CV_STORAGE=sharepoint.
# Reuses MS_TENANT_ID, MS_CLIENT_ID, and MS_CLIENT_SECRET above.
SHAREPOINT_DRIVE_ID=
SHAREPOINT_BASE_PATH=ADC-Careers/CVs

# Required when CV_STORAGE=google_drive.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Email notifications via Microsoft Graph (optional). Set MAIL_ENABLED=true to activate.
# Reuses the same Azure AD App Registration as CV_STORAGE=onedrive/sharepoint
# (MS_TENANT_ID / MS_CLIENT_ID / MS_CLIENT_SECRET below). The app registration needs
# the Microsoft Graph APPLICATION permission "Mail.Send" with admin consent granted,
# and should be scoped to MAIL_SEND_AS only via an Exchange ApplicationAccessPolicy.
MAIL_ENABLED=false
MAIL_SEND_AS=no-reply@asiadragoncordage.com
MAIL_HR_TO=hr@asiadragoncordage.com
PUBLIC_BASE_URL=http://localhost:5000

# Shared with OneDrive/SharePoint CV storage above — set these once.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
